{
  "ReverseProxy": {
    "Routes": {
      "catalogApiRoute": {
        "ClusterId": "catalogCluster",
        "Match": {
          "Path": "/api/v1/Products/{**catch-all}"
        }
      },
      "catalogRoute": {
        "ClusterId": "catalogCluster",
        "Match": {
          "Path": "/catalog/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/catalog"
          }
        ]
      },
      "pedidoApiRoute": {
        "ClusterId": "pedidoCluster",
        "Match": {
          "Path": "/api/Pedidos/{**catch-all}"
        }
      },
      "pedidoApiV1Route": {
        "ClusterId": "pedidoCluster",
        "Match": {
          "Path": "/api/v1/Pedidos/{**catch-all}"
        }
      },
      "pedidoRoute": {
        "ClusterId": "pedidoCluster",
        "Match": {
          "Path": "/pedidos/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/pedidos"
          }
        ]
      }
    },
    "Clusters": {
      "catalogCluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://catalog.api:8080/"
          }
        }
      },
      "pedidoCluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://gestao-pedidos.api:8080/"
          }
        }
      }
    }
  }
}
